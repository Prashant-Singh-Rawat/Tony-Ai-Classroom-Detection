# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
audit_output/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model weights & large binary artefacts ────────────────────────────────────
*.pt
*.pth
*.onnx
*.tflite
*.safetensors
*.bin
*.pkl
*.h5
*.pb
models/*.pt
models/*.onnx
**/checkpoints/**
!**/checkpoints/.gitkeep

# ── Data directories (legacy & root data) ─────────────────────────────────────
data/raw/**
data/processed/**
data/real/**
data/synthetic/**
data/evaluation/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/real/.gitkeep
!data/synthetic/.gitkeep
!data/evaluation/.gitkeep

# ── Large Datasets, Raw Images, Videos, Audio, and Generated Data ─────────────
